# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
# Docker가 PostgreSQL을 호스트에 공개할 포트. DB_PORT와 분리해 충돌을 방지한다.
POSTGRES_HOST_PORT=5432
DB_NAME=sodosiro
DB_USERNAME=postgres
DB_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Application (로컬 실행 및 Docker 공개 포트, 기본값: 8080)
SERVER_PORT=8080

# JWT (32바이트 이상 원본 키를 Base64로 인코딩. 생성: openssl rand -base64 48)
JWT_SECRET=
JWT_ISSUER=sodosiro

# Airflow 등 내부 ETL 콜백 검증용 공유 토큰 (openssl rand -hex 32)
INTERNAL_ETL_TOKEN=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_NATIVE_CLIENT_ID=
KAKAO_ADMIN_KEY=

# OpenAI (Spring AI)
OPENAI_API_KEY=sk-...

# Firebase Admin SDK 서비스 계정 JSON의 Git 미추적 외부 경로
FIREBASE_SERVICE_ACCOUNT_PATH=C:/sodosiro/secrets/firebase-service-account.json

# AWS S3
# IAM 사용자 액세스 키를 사용할 때 설정합니다. EC2/ECS IAM Role 사용 시에는 비워 둘 수 있습니다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# CloudFront를 사용하지 않으면 비워 둡니다. 예: d1234567890.cloudfront.net
AWS_CLOUDFRONT_DOMAIN=
