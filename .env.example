# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
# Docker가 PostgreSQL을 호스트에 공개할 포트. DB_PORT와 분리해 충돌을 방지한다.
POSTGRES_HOST_PORT=5432
DB_NAME=sodosiro
DB_USERNAME=postgres
DB_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Application (로컬 실행 및 Docker 공개 포트, 기본값: 8080)
SERVER_PORT=8080

# JWT (32바이트 이상 원본 키를 Base64로 인코딩. 생성: openssl rand -base64 48)
JWT_SECRET=
JWT_ISSUER=sodosiro

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_NATIVE_CLIENT_ID=
KAKAO_ADMIN_KEY=

# OpenAI (Spring AI)
OPENAI_API_KEY=sk-...
