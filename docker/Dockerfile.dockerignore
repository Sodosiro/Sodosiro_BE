# BuildKit 은 Dockerfile 과 같은 위치의 <Dockerfile>.dockerignore 를 우선 적용한다.
# 빌드 컨텍스트(프로젝트 루트) 기준 경로.

# 빌드 산출물
build/
.gradle/

# IDE / OS
.idea/
*.iml
.vscode/

# VCS
.git/
.gitignore

# 환경변수 (이미지에 절대 포함 금지)
.env
.env.*

# 문서 · 도커 파일 자체
docs/
*.md
docker/

# QueryDSL 생성물
src/main/generated/

# 로그
logs/
